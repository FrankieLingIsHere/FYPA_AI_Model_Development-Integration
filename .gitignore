# Workspace-level ignores
# Keep local environments, generated reports, logs, and agent/runtime state out of source control.

# Local agent/tooling state
.verdent/
.vercel/
.pytest_cache/
botiumwork/
output/
reports/

# Environment files generated during local runs/tests
.env
.env.local
.env.*.local
.env*.local

# Python caches and virtual environments
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
ENV/
env/

# Logs, backups, and temporary outputs
*.log
*.bak
*.tmp
*.out
*.err
*.cache
tmp/
temp/
tmp_*

# Generated validation artifacts and temporary outputs
Updated_Pipeline_Supabase/reports/
Updated_Pipeline_Supabase/violations/
Updated_Pipeline_Supabase/pipeline/reports/
Updated_Pipeline_Supabase/pipeline/violations/
Updated_Pipeline_Supabase/reports/Results/
Updated_Pipeline_Supabase/**/tmp/
Updated_Pipeline_Supabase/**/temp/
Updated_Pipeline_Supabase/.tmp_*
Updated_Pipeline_Supabase/*_stdout.log
Updated_Pipeline_Supabase/*_stderr.log
Updated_Pipeline_Supabase/*_pass.out.log
Updated_Pipeline_Supabase/*_pass.err.log

# Runtime/admin state
Updated_Pipeline_Supabase/assistant_session_records.json
Updated_Pipeline_Supabase/assistant_session_records.json.bak
Updated_Pipeline_Supabase/device_audit_log.json
Updated_Pipeline_Supabase/device_audit_log.json.bak
Updated_Pipeline_Supabase/bootstrap_tokens.json.bak
Updated_Pipeline_Supabase/pending_devices.json.bak
Updated_Pipeline_Supabase/bootstrap_tokens.json.tmp.*
Updated_Pipeline_Supabase/pending_devices.json.tmp.*
Updated_Pipeline_Supabase/pipeline/backend/data/gemini_budget_state.json

# Local worklogs and personal run notes
Worklogs/
MARKDOWN/WORKLOG_*.md
Updated_Pipeline_Supabase/WORKLOG_*.md
Updated_Pipeline_Supabase/docs/WORKLOG_*.md
COMMIT_ANALYSIS_*.md
DEVELOPMENT_CHALLENGES_*.md
